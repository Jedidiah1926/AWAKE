rules_version = '2';

// 데이터 구조는 lib/data/firestore_backend.dart 참고.
//
// teams/{teamId}/members/{uid}  { uid, teamName, displayName, role }
//   - leader: 팀 관리, 멤버 역할 변경, 초대 코드 관리
//   - editor: 곡/콘티 편집 (인도자, 반주자 등)
//   - member: 보기 + 자기 주석
// invites/{code}  { teamId, teamName, createdBy }
//   - 코드를 아는 사람만 읽을 수 있다 (목록 조회 불가).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function memberPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid);
    }

    function member(teamId) {
      return signedIn() && exists(memberPath(teamId));
    }

    function role(teamId) {
      return get(memberPath(teamId)).data.role;
    }

    function leader(teamId) {
      return member(teamId) && role(teamId) == 'leader';
    }

    function editor(teamId) {
      return member(teamId) && role(teamId) in ['leader', 'editor'];
    }

    // 지금 쓰는 묶음(batch)에서 팀을 새로 만들고 있고, 그 팀의 주인이 나인지.
    function foundingTeam(teamId) {
      return signedIn() &&
        !exists(teamPath(teamId)) &&
        getAfter(teamPath(teamId)).data.ownerId == request.auth.uid;
    }

    // "내 팀 목록" (컬렉션 그룹 쿼리: members where uid == 나).
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['teamId', 'teamName', 'createdBy']) &&
        (leader(request.resource.data.teamId) ||
         foundingTeam(request.resource.data.teamId));
      allow delete: if leader(resource.data.teamId);
      allow update: if false;
    }

    match /teams/{teamId} {
      allow read: if member(teamId);
      // 리더 멤버 문서를 같은 묶음에서 만들어야 한다.
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        getAfter(memberPath(teamId)).data.role == 'leader';
      allow update: if leader(teamId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if leader(teamId);

      match /members/{uid} {
        allow read: if member(teamId) ||
          (signedIn() && uid == request.auth.uid);

        // 1) 팀을 만든 사람이 자신을 리더로 등록
        // 2) 초대 코드로 자신을 멤버로 등록
        // 3) 리더가 등록
        allow create: if signedIn() && (
          (uid == request.auth.uid &&
           request.resource.data.uid == uid &&
           request.resource.data.role == 'leader' &&
           foundingTeam(teamId)) ||
          (uid == request.auth.uid &&
           request.resource.data.uid == uid &&
           request.resource.data.role == 'member' &&
           request.resource.data.inviteCode is string &&
           get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.teamId == teamId) ||
          leader(teamId)
        );

        // 역할 변경은 리더만. 자기 역할은 바꿀 수 없다 (리더가 없어지는 것 방지).
        allow update: if leader(teamId) &&
          uid != request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role in ['leader', 'editor', 'member'];

        // 리더가 내보내거나, 본인이 나간다 (팀 주인은 나갈 수 없음).
        allow delete: if (leader(teamId) && uid != request.auth.uid) ||
          (signedIn() && uid == request.auth.uid &&
           get(teamPath(teamId)).data.ownerId != uid);
      }

      match /songs/{songId} {
        allow read: if member(teamId);
        allow write: if editor(teamId);
      }

      match /setlists/{setlistId} {
        allow read: if member(teamId);
        allow write: if editor(teamId);
      }

      match /scores/{scoreId} {
        allow read: if member(teamId);
        allow write: if editor(teamId);

        match /annotations/{annotationId} {
          // 팀 공유 주석은 팀원 모두, 개인 주석은 작성자만 볼 수 있다.
          allow read: if member(teamId) &&
            (resource.data.visibility == 'team' ||
             resource.data.authorId == request.auth.uid);

          allow create: if member(teamId) &&
            request.resource.data.authorId == request.auth.uid &&
            request.resource.data.visibility in ['team', 'private'] &&
            request.resource.data.type in ['ink', 'text', 'mask'];

          // 작성자는 자기 주석을 고칠 수 있다 (작성자는 바꿀 수 없음).
          allow update: if member(teamId) &&
            resource.data.authorId == request.auth.uid &&
            request.resource.data.authorId == request.auth.uid;

          // 작성자, 또는 팀 공유 주석은 편집자도 지울 수 있다.
          allow delete: if member(teamId) &&
            (resource.data.authorId == request.auth.uid ||
             (resource.data.visibility == 'team' && editor(teamId)));
        }
      }
    }
  }
}
